<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Quorum" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "The lunch place everyone can actually say yes to." %>">
    <meta name="theme-color" content="#fff8e9">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Quorum">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", type: "module", defer: true, "data-turbo-track": "reload" %>
  </head>

  <body class="<%= content_for(:body_class) || "quorum-app" %>">
    <% if notice.present? %>
      <div class="q-toast q-toast-success" role="status"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="q-toast q-toast-error" role="alert"><%= alert %></div>
    <% end %>
    <%= yield %>
  </body>
</html>
